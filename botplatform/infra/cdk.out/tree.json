                      "aws:cdk:cloudformation:props": {
                        "accessTokenValidity": 60,
                        "allowedOAuthFlows": [
                          "implicit",
                          "code"
                        ],
                        "allowedOAuthFlowsUserPoolClient": true,
                        "allowedOAuthScopes": [
