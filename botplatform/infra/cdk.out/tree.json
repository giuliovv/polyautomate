                        "clientName": "botplatform-web",
                        "explicitAuthFlows": [
                          "ALLOW_USER_PASSWORD_AUTH",
                          "ALLOW_USER_SRP_AUTH",
                          "ALLOW_REFRESH_TOKEN_AUTH"
