# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/botplatform
REDIS_URL=redis://localhost:6379/0
SIGNER_URL=http://localhost:8001
SIGNER_SHARED_SECRET=your-signer-secret-change-in-production

# AWS Cognito
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Signer
SIGNER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/botplatform
SIGNER_BACKEND_SHARED_SECRET=your-signer-secret-change-in-production
SIGNER_KMS_KEY_ID=  # AWS KMS key ARN (optional, for production)
SIGNER_AWS_REGION=us-east-1

# Executor
EXECUTOR_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/botplatform
EXECUTOR_SIGNER_URL=http://localhost:8001
EXECUTOR_SIGNER_SHARED_SECRET=your-signer-secret-change-in-production
EXECUTOR_DRY_RUN=true
EXECUTOR_POLL_INTERVAL_SECONDS=30
EXECUTOR_POLYMARKETDATA_API_KEY=  # Get from polymarketdata.co

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend (Next.js)
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
